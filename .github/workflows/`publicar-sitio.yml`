# =====================================================================
# Publica el sitio en GitHub Pages (gratis, sin límite de publicaciones).
#  · Cada vez que usted guarda algo en el panel /admin  → se publica en 1-2 min
#  · Dos veces al día (6:17 a.m. y 2:17 p.m.)             → se publica de nuevo
#  · Botón "Run workflow" en la pestaña Actions           → publica a mano
#  En cada publicación se descargan las noticias más recientes.
# =====================================================================
name: Publicar sitio

on:
  push:
    branches: [main]
  schedule:
    - cron: '17 12 * * *'   # 6:17 a.m. hora del centro de México (UTC-6)
    - cron: '17 20 * * *'   # 2:17 p.m.
  workflow_dispatch:

permissions:
  contents: write    # guardar las noticias del día en el repositorio
  pages: write       # publicar en GitHub Pages
  id-token: write

concurrency:
  group: publicar-sitio
  cancel-in-progress: false

jobs:
  construir:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Descargar noticias del día
        continue-on-error: true   # si falla, se publica con las noticias anteriores
        run: node scripts/actualizar-noticias.mjs

      - name: Guardar noticias en el repositorio
        continue-on-error: true
        run: |
          git config user.name  "ebd-noticias[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add data/noticias.json
          if git diff --cached --quiet; then echo "Sin cambios en noticias."; else
            git commit -m "Noticias: actualización automática $(TZ=America/Mexico_City date '+%Y-%m-%d %H:%M')"
            git pull --rebase --autostash && git push
          fi

      - name: Generar índice del blog
        run: node scripts/generar-blog.mjs

      - uses: actions/configure-pages@v5
      - uses: actions/upload-pages-artifact@v3
        with:
          path: .

  publicar:
    needs: construir
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4

